<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title><%= @page_title %></title>
  <%= stylesheet_link_tag "administrate-internal/docs", media: "all" %>
  <link href='//fonts.googleapis.com/css?family=Lato|Source+Code+Pro|Fjalla+One' rel='stylesheet' type='text/css'>
  <link rel="stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/highlight.js/8.4/styles/default.min.css">
</head>

<body>
  <div class="content">
    <div class="sidebar">
      <h1>Administrate</h1>

      <ul class="sidebar-links">
        <li><a href="/">Home</a></li>
        <li><a href="https://github.com/thoughtbot/administrate">GitHub</a></li>
        <li><a href="https://github.com/thoughtbot/administrate/issues/new">Feedback</a></li>
        <li><a href="/contributing">Contributing Guide</a></li>
        <li><a href="/license">LICENSE</a></li>
      </ul>

      <h3>Documentation</h3>

      <ul class="sidebar-links">
        <% DocNavigation.tree.each do |item| %>
          <% is_active = @current_page_path == item.path %>
          <% has_active_child = item.children.any? { |c| @current_page_path == c.path } %>
          <li class="<%= 'active' if is_active %> <%= 'has-children' if item.children.any? %>">
            <a href="<%= item.url %>"><%= item.title %></a>
            <% if item.children.any? %>
              <ul>
                <% item.children.each do |child| %>
                  <li class="<%= 'active' if @current_page_path == child.path %>">
                    <a href="<%= child.url %>"><%= child.title %></a>
                  </li>
                <% end %>
              </ul>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>

    <div class="main">
      <% if @breadcrumbs&.any? %>
        <nav class="breadcrumbs">
          <% @breadcrumbs.each_with_index do |crumb, i| %>
            <% if i < @breadcrumbs.length - 1 %>
              <% if crumb[:url] %>
                <a href="<%= crumb[:url] %>"><%= crumb[:title] %></a>
              <% else %>
                <span><%= crumb[:title] %></span>
              <% end %>
            <% else %>
              <span><%= crumb[:title] %></span>
            <% end %>
          <% end %>
        </nav>
      <% end %>

      <%= yield %>
    </div>
  </div>

  <script src="//cdnjs.cloudflare.com/ajax/libs/highlight.js/8.4/highlight.min.js"></script>
  <script>hljs.initHighlightingOnLoad();</script>
</body>
</html>
